{
  "name": "tgsync",
  "version": "0.3.0",
  "private": true,
  "description": "tgsync: end-to-end encrypted shared folders through a Telegram group (engine + CLI)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-out --packages=external --log-level=warning && node --test .test-out/*.test.js",
    "typecheck": "tsc --noEmit",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=.test-out/bench.mjs --packages=external --log-level=warning && node .test-out/bench.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "age-encryption": "0.3.1",
    "ignore": "7.0.14"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
