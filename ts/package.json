{
  "name": "tgsync",
  "version": "0.3.0",
  "private": true,
  "description": "tgsync: end-to-end encrypted shared folders through a Telegram group (engine + CLI)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "tgsync": "dist/tgsync.mjs"
  },
  "scripts": {
    "build": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --outfile=dist/tgsync.mjs --target=node20 --loader:.wasm=binary --banner:js='#!/usr/bin/env node' --log-level=warning && chmod +x dist/tgsync.mjs",
    "test": "npm run build --silent && esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-out --packages=external --log-level=warning && node --test .test-out/*.test.js",
    "typecheck": "tsc --noEmit",
    "delete-group": "esbuild scripts/delete-group.ts --bundle --platform=node --format=esm --outfile=.test-out/delete-group.mjs --target=node20 --loader:.wasm=binary --log-level=warning && node .test-out/delete-group.mjs",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=.test-out/bench.mjs --packages=external --log-level=warning && node .test-out/bench.mjs"
  },
  "dependencies": {
    "@mtcute/node": "0.32.8",
    "@noble/hashes": "2.4.0",
    "age-encryption": "0.3.1",
    "ignore": "7.0.14"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
