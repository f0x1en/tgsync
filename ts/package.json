{
  "name": "tgsync",
  "version": "0.3.0",
  "private": true,
  "description": "tgsync: the host around the Rust core (vault, Telegram, setup), used by the Obsidian plugin",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "rm -rf .test-out && esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-out --packages=external --loader:.wasm=binary --target=node20 --log-level=warning && node --test .test-out/*.test.js",
    "typecheck": "tsc --noEmit",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=.test-out/bench.mjs --packages=external --loader:.wasm=binary --target=node20 --log-level=warning && node .test-out/bench.mjs",
    "bench-notes": "esbuild scripts/bench-notes.ts --bundle --platform=node --format=esm --outfile=.test-out/bench-notes.mjs --packages=external --loader:.wasm=binary --target=node20 --log-level=warning && node .test-out/bench-notes.mjs"
  },
  "dependencies": {
    "@mtcute/node": "0.32.8",
    "@noble/hashes": "2.4.0",
    "age-encryption": "0.3.1",
    "ignore": "7.0.14"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
