{
  "name": "tgsync-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin: end-to-end encrypted vault sync through a Telegram group (tgsync protocol v1)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-out --packages=external --log-level=warning && node --test .test-out/*.test.js"
  },
  "dependencies": {
    "age-encryption": "0.3.1",
    "ignore": "7.0.14"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
