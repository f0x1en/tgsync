{
  "name": "tgsync-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin for tgsync: a thin layer over the engine in ../ts",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "esbuild test/plugin.test.ts --bundle --platform=node --format=cjs --outfile=.test-out/plugin.test.cjs --alias:obsidian=./test/obsidian-stub.ts --target=node20 --loader:.wasm=binary --log-override:empty-import-meta=silent --log-level=warning && node --test .test-out/plugin.test.cjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
